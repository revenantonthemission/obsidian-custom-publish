---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BackLink from '../../../components/writing/BackLink.astro';
import { getTagIndex } from '../../../lib/data';
import { tagHref } from '../../../lib/tag-urls.mjs';
import '../../../styles/grouped.css';

// The tag index (mockups W7, M4; interaction-spec.md "Tag Chip"), at
// /writing/tags since U3 (BR1.1): the "‹ Writing" back link, then capsule chips
// at least 44 px tall, most used first. Every chip's address comes from the
// address module (BR2.1). The count is part of each link's name, read as
// "os, 글 12개"; the "#" is decoration. The "#" touches the name: any
// whitespace between them renders as a space, so that one line is kept out of
// Prettier, which would otherwise break it apart.
const tagIndex = getTagIndex();
const tags = Object.entries(tagIndex).sort((a, b) => b[1].length - a[1].length);
---

<BaseLayout title="Tags" surface="grouped">
  <header class="listing-header">
    <BackLink />
    <h1>태그</h1>
    <p class="listing-count">태그 {tags.length}개</p>
  </header>
  <ul class="tag-chips">
    {tags.map(([tag, posts]) => (
      <li>
        <a href={tagHref(tag)} class="tag-chip" aria-label={`${tag}, 글 ${posts.length}개`}>
          {/* prettier-ignore */}
          <span><span class="tag-chip-mark">#</span>{tag}</span>
          <span class="tag-chip-count">{posts.length}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
