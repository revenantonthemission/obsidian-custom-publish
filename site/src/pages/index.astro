---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeeklyPostList from '../components/writing/WeeklyPostList.astro';
import { getOrdinaryPosts, getPreviewSummary } from '../lib/data';
import { getProductionProfileAssembly } from '../lib/profile/production-profile.js';
import { SITE_NAME } from '../lib/site.js';
import { resolveKoreanBuildDate, weekPosts } from '../lib/writing-lists';
import '../styles/grouped.css';
import '../styles/home.css';
import '../styles/writing.css';

// The homepage (U1 W5; BR6.1–BR6.6; U2 BR2.1): one Large Title, then an
// opening with the owner's name, the short introduction and two equal capsules
// to the profile pages, then "이번 주 글" — the ordinary posts of the build's
// Korean week. Nothing is read from a vault note; the facts come from the
// approved profile and are rendered as text. The profile headline is never
// shown here (FR3.2).
const owner = getProductionProfileAssembly().homepage;

const week = weekPosts(getOrdinaryPosts(), resolveKoreanBuildDate(process.env));
const summaries = Object.freeze(
  Object.fromEntries(week.map((post) => [post.slug, getPreviewSummary(post.slug)]))
);
---

<BaseLayout title={SITE_NAME} surface="grouped">
  <h1 class="home-title">{SITE_NAME}</h1>
  <section class="home-opening" aria-labelledby="home-opening-name">
    <h2 id="home-opening-name" class="home-opening-name">
      {owner.name.value}
    </h2>
    <p class="home-opening-intro">{owner.shortIntro.value}</p>
    <nav class="home-opening-actions" aria-label="프로필 바로가기">
      <a href={owner.routes.resume} class="capsule" data-testid="home-opening-resume-link">
        Résumé
      </a>
      <a href={owner.routes.portfolio} class="capsule" data-testid="home-opening-portfolio-link">
        Portfolio
      </a>
    </nav>
  </section>
  <WeeklyPostList posts={week} summaries={summaries} allHref="/writing/all" />
</BaseLayout>
