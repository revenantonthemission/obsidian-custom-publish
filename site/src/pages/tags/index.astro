---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getTagIndex } from "../../lib/data";
import "../../styles/grouped.css";

// The tag index (mockups W7; interaction-spec.md "Tag Chip"): capsule chips
// at least 44 px tall, most used first. The count is part of each link's
// name, read as "os, 글 12개"; the "#" is decoration.
const tagIndex = getTagIndex();
const tags = Object.entries(tagIndex).sort((a, b) => b[1].length - a[1].length);
---

<BaseLayout title="Tags" surface="grouped">
  <header class="listing-header">
    <h1>태그</h1>
    <p class="listing-count">태그 {tags.length}개</p>
  </header>
  <ul class="tag-chips">
    {tags.map(([tag, posts]) => (
      <li>
        <a href={`/tags/${tag}`} class="tag-chip" aria-label={`${tag}, 글 ${posts.length}개`}>
          <span><span class="tag-chip-mark">#</span>{tag}</span>
          <span class="tag-chip-count">{posts.length}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
