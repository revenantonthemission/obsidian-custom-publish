---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getAllPostMeta, getPreviewSummary } from "../lib/data";
import "../styles/grouped.css";

// Not found (mockups W11; FR4.3): what happened, the two ways on (search is
// the filled primary action and opens the search dialog), and recent posts.
const recentPosts = getAllPostMeta().filter((p) => !p.is_hub).slice(0, 5);
---

<BaseLayout title="페이지를 찾을 수 없습니다">
  <div class="not-found">
    <h1>페이지를 찾을 수 없습니다</h1>
    <p class="not-found-lead">주소가 바뀌었을 수 있습니다.</p>
    <div class="not-found-actions">
      <button type="button" class="capsule capsule-filled" data-search-open>사이트 검색</button>
      <a href="/" class="capsule">홈으로</a>
    </div>
    {recentPosts.length > 0 && (
      <section class="not-found-recent" aria-labelledby="not-found-recent-heading">
        <h2 id="not-found-recent-heading">최근 글</h2>
        <ul class="grouped-list">
          {recentPosts.map((post) => (
            <PostCard post={post} summary={getPreviewSummary(post.slug)} />
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .not-found {
    max-inline-size: var(--max-reading);
    margin-inline: auto;
    padding-block: var(--space-8) 0;
  }

  .not-found-lead {
    color: var(--c-text-secondary);
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block: var(--space-6) var(--space-12);
  }

  .not-found-recent h2 {
    margin-block: 0 var(--space-3);
    font-size: var(--text-title-3);
  }
</style>
