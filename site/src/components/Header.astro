---
import ThemeToggle from "../islands/ThemeToggle.tsx";
import MobileNav from "../islands/MobileNav.tsx";
import {
  BriefcaseBusiness,
  FileText,
  Search,
  Split,
  Tags,
  Waypoints,
} from "lucide-static";
import { getPrimaryNavigationState } from "../lib/navigation.js";

interface Props {
  pathname?: string;
}

const { pathname = "/" } = Astro.props;
const navigationResult = getPrimaryNavigationState(pathname);
if (!navigationResult.ok) {
  throw new TypeError("Invalid primary navigation state.");
}
const primaryNavigation = navigationResult.value;
const navigationIcons = Object.freeze({
  "/tags": Tags,
  "/graph": Waypoints,
  "/resume": FileText,
  "/portfolio": BriefcaseBusiness,
}) as Readonly<Record<string, string>>;
---

<header class="site-header">
  <a href="/" class="site-title" aria-current={pathname === "/" ? "page" : undefined}>
    <span class="nav-icon" set:html={Split} />
    obsidian-press
  </a>
  <nav class="desktop-nav" aria-label="주요 탐색">
    {primaryNavigation.map((item) => (
      <a
        href={item.href}
        class="site-nav-link"
        aria-current={item.current ? "page" : undefined}
        data-testid={`primary-navigation-link-${item.href.slice(1)}`}
      >
        <span
          class="nav-icon"
          aria-hidden="true"
          set:html={navigationIcons[item.href]}
        />
        {item.label}
      </a>
    ))}
    <button class="search-trigger" aria-label="검색 열기" data-search-open>
      <span class="nav-icon" set:html={Search} />
      <kbd>⌘K</kbd>
    </button>
    <ThemeToggle client:load />
  </nav>
  <div class="mobile-nav">
    <button class="search-trigger mobile" aria-label="검색 열기" data-search-open>
      <span class="nav-icon" set:html={Search} />
    </button>
    <ThemeToggle client:load />
    <MobileNav items={primaryNavigation} />
  </div>
</header>

<script>
  document.querySelectorAll("[data-search-open]").forEach((btn) => {
    btn.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("open-search"));
    });
  });
</script>

<style>
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: none;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    color: var(--c-text-muted);
    font-size: 0.85rem;
    transition: background 0.15s, color 0.15s;
  }
  .search-trigger:hover {
    color: var(--c-text);
    background: var(--c-code-bg);
  }
  .search-trigger kbd {
    font-family: var(--font-body);
    font-size: 0.7rem;
    padding: 0.1em 0.35em;
    border: 1px solid var(--c-border);
    border-radius: 3px;
    background: var(--c-bg);
    color: var(--c-text-muted);
  }
  .search-trigger.mobile kbd {
    display: none;
  }
  .search-trigger .nav-icon svg {
    width: 15px;
    height: 15px;
  }
</style>
