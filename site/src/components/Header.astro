---
import ThemeToggle from "../islands/ThemeToggle.tsx";
import MobileNav from "../islands/MobileNav.tsx";
import { Search, Split } from "lucide-static";
import { decorativeIcon } from "../lib/icons";
import { getPrimaryNavigationState } from "../lib/navigation.js";

interface Props {
  pathname?: string;
}

const { pathname = "/" } = Astro.props;
const navigationResult = getPrimaryNavigationState(pathname);
if (!navigationResult.ok) {
  throw new TypeError("Invalid primary navigation state.");
}
const primaryNavigation = navigationResult.value;

// The floating glass bar (FR4.1; mockups.md W1–W2). One instance of every
// control serves all widths: under 768 px the sections move into the
// navigation sheet, from 768 px they sit in the bar.
//
// The glass is its own layer behind the bar's content: an element with a
// backdrop-filter becomes the containing block of position: fixed
// descendants, which would trap the full-height navigation sheet in the bar.
---

<header class="site-header">
  <div class="site-bar">
    <span class="site-bar-material" data-material="regular" aria-hidden="true"></span>
    <a href="/" class="site-title" aria-current={pathname === "/" ? "page" : undefined}>
      <span class="site-mark" set:html={decorativeIcon(Split, 20)} />
      <span class="site-title-text">obsidian-press</span>
    </a>
    <nav class="desktop-nav" aria-label="주요 탐색">
      {primaryNavigation.map((item) => (
        <a
          href={item.href}
          class="site-nav-link"
          aria-current={item.current ? "page" : undefined}
          data-testid={`primary-navigation-link-${item.href.slice(1)}`}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="site-actions">
      <button type="button" class="search-trigger" aria-label="검색 열기" data-search-open>
        <span class="search-icon" set:html={decorativeIcon(Search, 20)} />
        <kbd class="search-shortcut" aria-hidden="true"
          ><span data-platform-only="apple">⌘K</span><span data-platform-only="other">Ctrl K</span></kbd
        >
      </button>
      <ThemeToggle client:load />
      <MobileNav items={primaryNavigation} />
    </div>
    <div class="reading-progress" aria-hidden="true"></div>
  </div>
</header>

<script>
  // Any [data-search-open] control opens the search dialog (islands/Search.tsx),
  // which returns focus to that control when it closes.
  document.querySelectorAll("[data-search-open]").forEach((btn) => {
    btn.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("open-search", { detail: { trigger: btn } }));
    });
  });
</script>
