---
import BaseLayout from '../layouts/BaseLayout.astro';
import GraphView from '../islands/GraphView.tsx';
import GraphList from '../components/GraphList.astro';
import { getGraph } from '../lib/data';
import '../styles/segmented.css';
import '../styles/grouped.css';
import '../styles/graph.css';

// The graph page (mockups W8; FR4.3, FR4.5, FR5.6). The 그래프 tab holds the
// force-directed graph, which loads /graph.json itself so it can show loading,
// error and empty states. The 목록 tab is the same graph as a list of links,
// built with the page: the keyboard path, and the fallback without
// JavaScript. The graph image's description points readers to it.
const graphData = getGraph();
---

<BaseLayout title="Graph">
  <header class="graph-header">
    <h1>그래프</h1>
    <div class="graph-tabs segmented" role="tablist" aria-label="그래프 보기 방식" data-tabs>
      <button
        type="button"
        role="tab"
        id="graph-tab-graph"
        aria-controls="graph-panel-graph"
        aria-selected="true"
      >
        그래프
      </button>
      <button
        type="button"
        role="tab"
        id="graph-tab-list"
        aria-controls="graph-panel-list"
        aria-selected="false"
        tabindex="-1"
      >
        목록
      </button>
    </div>
  </header>

  <div role="tabpanel" id="graph-panel-graph" aria-labelledby="graph-tab-graph">
    <p id="graph-hint" class="graph-hint">
      끌어서 옮기고 확대할 수 있습니다. 키보드로는 목록 탭에서 모든 노트와 연결을 볼 수 있습니다.
    </p>
    <div class="graph-container">
      <GraphView client:load descriptionId="graph-hint" />
    </div>
  </div>

  <div role="tabpanel" id="graph-panel-list" aria-labelledby="graph-tab-list" hidden>
    <GraphList data={graphData} />
  </div>

  <script>
    import '../scripts/tabs';
  </script>
</BaseLayout>
