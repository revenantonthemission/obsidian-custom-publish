---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Search from "../islands/Search.tsx";
import { serializeJsonLdDocuments } from "../lib/layout/json-ld.js";
import {
  resolveRouteResourcePolicy,
  validateRouteResourcePolicy,
} from "../lib/layout/profile-resources.js";
import type { ProfilePageMetadata } from "../lib/profile/metadata.js";

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  canonicalUrl?: string;
  metadata?: ProfilePageMetadata;
}

const props = Astro.props;
const defaultTitle = "obsidian-press";
const defaultDescription = "obsidian-press — personal knowledge base";
const defaultOgType = "website";
const siteUrl = "https://rvnnt.dev";
const legacyTitle = props.title ?? defaultTitle;
const legacyDescription = props.description ?? defaultDescription;
const legacyOgType = props.ogType ?? defaultOgType;
const legacyFullUrl = props.canonicalUrl
  ? `${siteUrl}${props.canonicalUrl}`
  : siteUrl;
const metadata = props.metadata;
const normalizedPathname =
  Astro.url.pathname.length > 1 && Astro.url.pathname.endsWith("/")
    ? Astro.url.pathname.slice(0, -1)
    : Astro.url.pathname;

if (
  metadata !== undefined &&
  (
    metadata.pathname !== normalizedPathname ||
    (props.title !== undefined && props.title !== metadata.title) ||
    (
      props.description !== undefined &&
      props.description !== metadata.description
    ) ||
    (
      props.canonicalUrl !== undefined &&
      legacyFullUrl !== metadata.canonical
    ) ||
    (props.ogType !== undefined && props.ogType !== defaultOgType)
  )
) {
  throw new TypeError("Conflicting BaseLayout metadata.");
}

const resolvedResources = resolveRouteResourcePolicy(Astro.url.pathname);
if (!resolvedResources.ok) {
  throw new TypeError("Invalid BaseLayout resource policy.");
}
const verifiedResources = validateRouteResourcePolicy(
  Astro.url.pathname,
  resolvedResources.value,
);
if (!verifiedResources.ok) {
  throw new TypeError("Invalid BaseLayout resource policy.");
}
const resourcePolicy = verifiedResources.value;

const serializedJsonLd = serializeJsonLdDocuments(metadata?.jsonLd);
if (!serializedJsonLd.ok) {
  throw new TypeError("Invalid BaseLayout JSON-LD documents.");
}
const jsonLdScripts = serializedJsonLd.value;

const title = metadata?.title ?? legacyTitle;
const description = metadata?.description ?? legacyDescription;
const ogType = metadata === undefined ? legacyOgType : defaultOgType;
const fullUrl = metadata?.canonical ?? legacyFullUrl;
const openGraph = metadata?.openGraph;
const twitter = metadata?.twitter;
---
<html lang="ko" data-theme="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={openGraph?.title ?? title} />
    <meta property="og:description" content={openGraph?.description ?? description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={openGraph?.url ?? fullUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={twitter?.title ?? title} />
    <meta name="twitter:description" content={twitter?.description ?? description} />
    <link rel="canonical" href={fullUrl} />
    <link rel="alternate" type="application/rss+xml" title="obsidian-press RSS" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {resourcePolicy.headResources.map((resource) => (
      <link
        rel={resource.rel}
        href={resource.href}
        crossorigin={resource.crossorigin}
      />
    ))}
    {jsonLdScripts?.map((script) => (
      <script
        type={script.type}
        is:inline
        set:html={script.payload}
      />
    ))}
    <script is:inline>
      // Apply saved theme immediately to prevent flash of unthemed content.
      // This runs synchronously before any other JS, so it MUST NOT throw —
      // wrap the whole body in try/catch with a minimal fallback.
      (function() {
        try {
          var theme;
          var manual = localStorage.getItem("theme-manual");
          var solar = null;
          var DAY_MS = 86400000;

          // Try to read cached solar data for today
          try {
            var raw = localStorage.getItem("solar");
            if (raw) {
              solar = JSON.parse(raw);
              var today = new Date().toISOString().slice(0, 10);
              if (!solar || solar.date !== today) solar = null;
            }
          } catch(e) { solar = null; }

          if (manual && solar) {
            // Manual override present — check if it's still valid
            var mt = new Date(manual);
            var now = new Date();
            var sr = new Date(solar.sunrise);
            var ss = new Date(solar.sunset);
            // Overrides older than 24h have definitely crossed a boundary
            var stale = (now.getTime() - mt.getTime()) > DAY_MS;
            var boundaryPassed = stale || (mt < sr && now >= sr) || (mt < ss && now >= ss);
            if (boundaryPassed) {
              localStorage.removeItem("theme-manual");
              theme = (now >= sr && now < ss) ? "light" : "dark";
            } else {
              theme = localStorage.getItem("theme");
            }
          } else if (solar) {
            var now2 = new Date();
            var sr2 = new Date(solar.sunrise);
            var ss2 = new Date(solar.sunset);
            theme = (now2 >= sr2 && now2 < ss2) ? "light" : "dark";
          } else {
            theme = localStorage.getItem("theme");
            if (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches) {
              theme = "dark";
            }
          }

          if (theme) document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          // Last-resort fallback — just read the saved theme
          try {
            var t = localStorage.getItem("theme");
            if (t) document.documentElement.setAttribute("data-theme", t);
          } catch (e2) {}
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">본문으로 건너뛰기</a>
    <div class="reading-progress" aria-hidden="true"></div>
    <Header pathname={Astro.url.pathname} />
    <main id="main-content" class="site-main">
      <slot />
    </main>
    <Search client:idle />
    <Footer />

    <button class="back-to-top" aria-label="맨 위로">↑</button>

    <script is:inline>
      // Reading progress bar
      var progressBar = document.querySelector(".reading-progress");
      if (progressBar) {
        window.addEventListener("scroll", function() {
          var h = document.documentElement.scrollHeight - window.innerHeight;
          progressBar.style.width = h > 0 ? (window.scrollY / h * 100) + "%" : "0%";
        }, { passive: true });
      }

      // Back-to-top button
      var btt = document.querySelector(".back-to-top");
      if (btt) {
        btt.addEventListener("click", function() {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
        window.addEventListener("scroll", function() {
          btt.classList.toggle("visible", window.scrollY > 400);
        }, { passive: true });
      }
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
  @import "../styles/callouts.css";
  @import "../styles/diagrams.css";
  @import "../styles/search.css";
</style>
