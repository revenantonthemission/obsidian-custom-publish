  "notApplicable": [
    {
      "id": "PBT-C01-ROUNDTRIP",
      "rationale": "C01 has no public encode/decode pair; JSON-LD round-trip belongs to C04."
    },
    {
      "id": "PBT-C01-COMMUTATIVITY",
      "rationale": "Normalization, validation and projection are intentionally ordered."
    },
    {
      "id": "PBT-C01-INDUCTION",
      "rationale": "The bounded aggregate has no recursive or divide-and-conquer operation."
    },
    {
      "id": "PBT-C02-ROUNDTRIP-IDEMPOTENCE-COMMUTATIVITY-INDUCTION",
      "rationale": "C02 is a one-way semantic presentation; browser examples own visual and interaction behavior."
    },
    {
      "id": "PBT-C03-ROUNDTRIP",
      "rationale": "C03 builds typed documents; C04 owns serialization round-trip."
    },
    {
      "id": "PBT-C04-IDEMPOTENCE-COMMUTATIVITY-INDUCTION",
      "rationale": "Hosted output is not fed back as input and document order is observable."
    },
    {
      "id": "PBT-C05-ROUNDTRIP-IDEMPOTENCE-COMMUTATIVITY-INDUCTION",
      "rationale": "Navigation is a fixed ordered projection without an inverse or recursion."
    },
    {
      "id": "PBT-C11-PDF-BINARY-ROUNDTRIP",
      "rationale": "PDF bytes are a lossy presentation boundary; full manifest equality is the semantic oracle."
    },
    {
      "id": "PBT-HUMAN-FACT-APPROVAL",
      "rationale": "A generator cannot establish truth, evidence sufficiency or human approval."
    }
  ]
