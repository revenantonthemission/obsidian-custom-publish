---
interface Props {
  text: string;
  withSubtitles?: boolean;
}

const { text, withSubtitles = false } = Astro.props;
// An authored first line is the subtitle; the remainder is its body. Keep the
// body's leading newline so HTML minification cannot join the two text values.
const separator = withSubtitles ? text.indexOf("\n") : -1;
---

{separator > 0 ? (
  <>
    <h5 class="profile-content-subtitle">{text.slice(0, separator)}</h5>
    <p class="profile-content-paragraph">{text.slice(separator)}</p>
  </>
) : text}
