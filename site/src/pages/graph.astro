---
import BaseLayout from "../layouts/BaseLayout.astro";
import GraphView from "../islands/GraphView.tsx";
import { getGraph } from "../lib/data";

const graphData = getGraph();
---

<BaseLayout title="Graph">
  <h1>그래프 뷰</h1>
  <p class="graph-hint">핀치하여 확대 · 노드를 드래그해 배치를 바꿀 수 있어요</p>
  <div class="graph-container">
    <GraphView client:load data={graphData} />
  </div>
</BaseLayout>

<style>
  .graph-container {
    position: relative;
    margin-top: 1rem;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    overflow: hidden;
    width: 100%;
    height: calc(100vh - 16rem);
    min-height: 420px;
  }

  .graph-hint {
    color: var(--c-text-muted);
    font-size: 0.8rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 767px) {
    .graph-container {
      height: calc(100dvh - 14rem);
    }
  }
</style>

<style is:global>
  .graph-ui {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    pointer-events: none;
  }

  .graph-ui > * {
    pointer-events: auto;
  }

  .graph-search {
    width: min(14rem, 60vw);
    padding: 0.4rem 0.7rem;
    font-size: 0.85rem;
    color: var(--c-text);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 999px;
  }

  .graph-search:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 1px;
  }

  .graph-match-count {
    font-size: 0.75rem;
    color: var(--c-text-muted);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
  }

  .graph-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-left: auto;
  }

  .graph-legend-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: var(--c-text-muted);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .graph-legend-chip:hover {
    color: var(--c-text);
  }

  .graph-legend-chip:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 1px;
  }

  .graph-legend-chip.active {
    color: var(--c-text);
    border-color: var(--c-accent);
  }

  .graph-legend-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  @media (max-width: 767px) {
    .graph-legend {
      margin-left: 0;
    }
  }
</style>
