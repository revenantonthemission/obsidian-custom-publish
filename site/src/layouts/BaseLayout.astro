---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../islands/Search.tsx';
import { ArrowUp } from 'lucide-static';
import { decorativeIcon } from '../lib/icons';
import { serializeJsonLdDocuments } from '../lib/layout/json-ld.js';
import {
  resolveRouteResourcePolicy,
  validateRouteResourcePolicy,
} from '../lib/layout/profile-resources.js';
import type { ProfilePageMetadata } from '../lib/profile/metadata.js';
// The self-hosted Pretendard (FR2.2). Imported here, not through global.css:
// only a stylesheet imported from a module gets its nested url()s resolved,
// so only this way does Vite emit the font files (hig-built-assets.test.ts).
import '../styles/fonts.css';
// The two Pretendard subsets that cover Latin and the most frequent Hangul
// (R-10). Vite emits them once; the @font-face rules in fonts.css point at
// the same hashed files, so the preloads are reused, never fetched twice.
import pretendardCommonSubset from '../../.generated/profile-font/woff2-dynamic-subset/PretendardVariable.subset.91.woff2?url';
import pretendardHangulSubset from '../../.generated/profile-font/woff2-dynamic-subset/PretendardVariable.subset.90.woff2?url';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  canonicalUrl?: string;
  metadata?: ProfilePageMetadata;
  /** Reading pages sit on --c-bg; pages of grouped lists on --c-bg-grouped. */
  surface?: 'reading' | 'grouped';
}

const props = Astro.props;
const defaultTitle = 'obsidian-press';
const defaultDescription = 'obsidian-press — personal knowledge base';
const defaultOgType = 'website';
const siteUrl = 'https://rvnnt.dev';
const legacyTitle = props.title ?? defaultTitle;
const legacyDescription = props.description ?? defaultDescription;
const legacyOgType = props.ogType ?? defaultOgType;
const legacyFullUrl = props.canonicalUrl ? `${siteUrl}${props.canonicalUrl}` : siteUrl;
const metadata = props.metadata;
const normalizedPathname =
  Astro.url.pathname.length > 1 && Astro.url.pathname.endsWith('/')
    ? Astro.url.pathname.slice(0, -1)
    : Astro.url.pathname;

if (
  metadata !== undefined &&
  (metadata.pathname !== normalizedPathname ||
    (props.title !== undefined && props.title !== metadata.title) ||
    (props.description !== undefined && props.description !== metadata.description) ||
    (props.canonicalUrl !== undefined && legacyFullUrl !== metadata.canonical) ||
    (props.ogType !== undefined && props.ogType !== defaultOgType))
) {
  throw new TypeError('Conflicting BaseLayout metadata.');
}

const resolvedResources = resolveRouteResourcePolicy(Astro.url.pathname);
if (!resolvedResources.ok) {
  throw new TypeError('Invalid BaseLayout resource policy.');
}
const verifiedResources = validateRouteResourcePolicy(Astro.url.pathname, resolvedResources.value);
if (!verifiedResources.ok) {
  throw new TypeError('Invalid BaseLayout resource policy.');
}
const resourcePolicy = verifiedResources.value;

const serializedJsonLd = serializeJsonLdDocuments(metadata?.jsonLd);
if (!serializedJsonLd.ok) {
  throw new TypeError('Invalid BaseLayout JSON-LD documents.');
}
const jsonLdScripts = serializedJsonLd.value;

const title = metadata?.title ?? legacyTitle;
const description = metadata?.description ?? legacyDescription;
const ogType = metadata === undefined ? legacyOgType : defaultOgType;
const fullUrl = metadata?.canonical ?? legacyFullUrl;
const openGraph = metadata?.openGraph;
const twitter = metadata?.twitter;
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={openGraph?.title ?? title} />
    <meta property="og:description" content={openGraph?.description ?? description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={openGraph?.url ?? fullUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={twitter?.title ?? title} />
    <meta name="twitter:description" content={twitter?.description ?? description} />
    <link rel="canonical" href={fullUrl} />
    <link rel="alternate" type="application/rss+xml" title="obsidian-press RSS" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={pretendardCommonSubset} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={pretendardHangulSubset} as="font" type="font/woff2" crossorigin />
    {resourcePolicy.headResources.map((resource) => (
      <link rel={resource.rel} href={resource.href} crossorigin={resource.crossorigin} />
    ))}
    {jsonLdScripts?.map((script) => (
      <script type={script.type} is:inline set:html={script.payload} />
    ))}
    <script is:inline>
      // Appearance bootstrap (FR3.2): runs before first paint, so it is ES5
      // and must never throw. CSS follows the system appearance by itself;
      // this only applies an explicit choice and records the mode for the
      // appearance button (src/lib/appearance.ts holds the same rules).
      (function () {
        var root = document.documentElement;
        var appearance = 'auto';
        var storage = null;
        try {
          storage = window.localStorage;
        } catch (e) {
          storage = null;
        }
        if (storage) {
          try {
            var stored = storage.getItem('appearance');
            if (stored === 'light' || stored === 'dark' || stored === 'auto') appearance = stored;
          } catch (e) {}
          var legacy = ['theme', 'theme-manual', 'solar', 'geo', 'geo-denied'];
          for (var i = 0; i < legacy.length; i++) {
            try {
              storage.removeItem(legacy[i]);
            } catch (e) {}
          }
        }
        if (appearance !== 'auto') root.setAttribute('data-theme', appearance);
        root.setAttribute('data-appearance', appearance);
        // The search shortcut hint reads ⌘K on Apple platforms, Ctrl K elsewhere (FR5.9).
        var platform = '';
        try {
          platform =
            (navigator.userAgentData && navigator.userAgentData.platform) ||
            navigator.platform ||
            '';
        } catch (e) {}
        root.setAttribute(
          'data-platform',
          /mac|iphone|ipad|ipod/i.test(platform) ? 'apple' : 'other'
        );
      })();
    </script>
  </head>
  <body data-surface={props.surface ?? 'reading'}>
    <a href="#main-content" class="skip-link">
      본문으로 건너뛰기
    </a>
    <Header pathname={Astro.url.pathname} />
    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>
    <Search client:idle />
    <Footer />

    <button type="button" class="back-to-top" aria-label="맨 위로" data-material="regular">
      <Fragment set:html={decorativeIcon(ArrowUp, 20)} />
    </button>

    <script is:inline>
      // Reading progress and back to top (FR5.10): one update per animation
      // frame, the progress drawn by transform: scaleX(), and a jump instead
      // of a smooth scroll when the reader asks for reduced motion.
      (function () {
        var progress = document.querySelector('.reading-progress');
        var top = document.querySelector('.back-to-top');
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        var pending = false;
        function update() {
          pending = false;
          var root = document.documentElement;
          var range = root.scrollHeight - window.innerHeight;
          var y = window.scrollY || root.scrollTop;
          if (progress)
            progress.style.transform = 'scaleX(' + (range > 0 ? Math.min(y / range, 1) : 0) + ')';
          if (top) top.classList.toggle('visible', y > 400);
        }
        function schedule() {
          if (pending) return;
          pending = true;
          window.requestAnimationFrame(update);
        }
        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', schedule, { passive: true });
        if (top) {
          top.addEventListener('click', function () {
            if (reduceMotion.matches) window.scrollTo(0, 0);
            else window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }
        update();
      })();
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
