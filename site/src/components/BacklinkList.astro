---
import PostCard from './PostCard.astro';
import { getPostMeta, getPreviewSummary } from '../lib/data';

interface Props {
  backlinks: string[];
}

// Posts that link here, as an inset grouped list below the article (W3).
const { backlinks } = Astro.props;
const backlinkMetas = backlinks.map((slug) => getPostMeta(slug)).filter((m) => m !== null);
---

{backlinkMetas.length > 0 && (
  <section class="backlinks" aria-labelledby="backlinks-heading">
    <h2 id="backlinks-heading">이 페이지를 참조하는 글</h2>
    <ul class="grouped-list">
      {backlinkMetas.map((meta) => (
        <PostCard post={meta} summary={getPreviewSummary(meta.slug)} />
      ))}
    </ul>
  </section>
)}
