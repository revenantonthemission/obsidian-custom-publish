---
import { extractToc } from "../lib/toc";

interface Props {
  content: string;
}

// The 목차 tab names this list; rows are 44 px tall at every width (FR5.8,
// mockups review finding R-03). Styles live in styles/outline.css because the
// list moves into the outline sheet on narrow screens.
const { content } = Astro.props;
const headings = extractToc(content);
---

{headings.length > 0 && (
  <nav class="toc" aria-label="목차">
    <ul class="toc-list">
      {headings.map((h) => (
        <li class={`toc-item toc-depth-${h.depth}`}>
          <a href={`#${h.id}`}>{h.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}
