---
import BaseLayout from "./BaseLayout.astro";
import HubNav from "../components/HubNav.astro";
import HubProgress from "../components/HubProgress.astro";
import PostCard from "../components/PostCard.astro";
import { getPreviewSummary, sanitizeTag } from "../lib/data";
import type { PostMeta } from "../lib/types";
import "../styles/grouped.css";

interface Props {
  hub: PostMeta;
  children: PostMeta[];
}

// A hub page (mockups W6; FR4.3, FR4.5): the breadcrumb, a Large Title with
// the post count and tag chips, then the hub's posts as one inset grouped
// list on the grouped background. A hub without posts says so in the group.
const { hub, children } = Astro.props;
---

<BaseLayout title={hub.title} surface="grouped">
  <HubNav hub={hub} children={children} />

  <header class="listing-header">
    <h1>{hub.title}</h1>
    <HubProgress total={children.length} />
    {hub.tags.length > 0 && (
      <ul class="tag-chips" aria-label="태그">
        {hub.tags.map((tag) => (
          <li>
            <a href={`/tags/${sanitizeTag(tag)}`} class="tag-chip"><span class="tag-chip-mark" aria-hidden="true">#</span>{tag}</a>
          </li>
        ))}
      </ul>
    )}
  </header>

  <ul class="grouped-list">
    {children.length > 0 ? (
      children.map((post) => <PostCard post={post} summary={getPreviewSummary(post.slug)} />)
    ) : (
      <li class="grouped-empty">이 허브에 연결된 글이 아직 없습니다.</li>
    )}
  </ul>
</BaseLayout>
