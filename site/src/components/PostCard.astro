---
import { ChevronRight } from 'lucide-static';
import { decorativeIcon } from '../lib/icons';
import { formatDateKo } from '../lib/data';
import type { PostMeta } from '../lib/types';
import '../styles/grouped.css';

interface Props {
  post: PostMeta;
  summary?: string;
}

// One row of an inset grouped list (interaction-spec.md "Grouped List and
// Post Row"): a single link holding the title, the summary clamped to two
// lines and the date, at least 60 px tall. Tags are not links here, so no
// target nests inside another; tag chips live on the post page. Render it
// inside ul.grouped-list.
const { post, summary } = Astro.props;
---

<li>
  <a href={`/posts/${post.slug}`} class="grouped-row">
    <span class="grouped-row-text">
      <span class="grouped-row-title">{post.title}</span>
      {summary && <span class="grouped-row-summary">{summary}</span>}
      <span class="grouped-row-meta">
        {post.published && <time datetime={post.published}>{formatDateKo(post.published)}</time>}
        <span>{post.reading_time_min}분 읽기</span>
      </span>
    </span>
    <span class="grouped-row-chevron" set:html={decorativeIcon(ChevronRight, 18)} />
  </a>
</li>
