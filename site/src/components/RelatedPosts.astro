---
import PostCard from './PostCard.astro';
import { getPostMeta, getPreviewSummary } from '../lib/data';

interface Props {
  slugs: string[];
}

// Up to five related posts, as an inset grouped list below the article (W3).
const { slugs } = Astro.props;
const metas = slugs.map((s) => getPostMeta(s)).filter((m) => m !== null);
---

{metas.length > 0 && (
  <section class="related-posts" aria-labelledby="related-posts-heading">
    <h2 id="related-posts-heading">관련 글</h2>
    <ul class="grouped-list">
      {metas.map((meta) => (
        <PostCard post={meta} summary={getPreviewSummary(meta.slug)} />
      ))}
    </ul>
  </section>
)}
