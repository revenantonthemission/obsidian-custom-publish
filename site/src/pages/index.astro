---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getOrdinaryPosts, getPreviewSummary } from '../lib/data';
import { filterTodayPosts, resolveBuildDate } from '../lib/homepage';
import { getProductionProfileAssembly } from '../lib/profile/production-profile.js';
import { SITE_NAME } from '../lib/site.js';
import '../styles/grouped.css';
import '../styles/home.css';

// The homepage (U1 W5; BR6.1–BR6.6): one Large Title, then an opening with
// the owner's name, the short introduction and two equal capsules to the
// profile pages, then the interim "오늘 발행된 글" list, which U2 replaces.
// Nothing is read from a vault note; the facts come from the approved profile
// and are rendered as text. The profile headline is never shown here (FR3.2).
const owner = getProductionProfileAssembly().homepage;

const today = resolveBuildDate(process.env);
const recentPosts = filterTodayPosts(getOrdinaryPosts(), today);
---

<BaseLayout title={SITE_NAME} surface="grouped">
  <h1 class="home-title">{SITE_NAME}</h1>
  <section class="home-opening" aria-labelledby="home-opening-name">
    <h2 id="home-opening-name" class="home-opening-name">
      {owner.name.value}
    </h2>
    <p class="home-opening-intro">{owner.shortIntro.value}</p>
    <nav class="home-opening-actions" aria-label="프로필 바로가기">
      <a href={owner.routes.resume} class="capsule" data-testid="home-opening-resume-link">
        Résumé
      </a>
      <a href={owner.routes.portfolio} class="capsule" data-testid="home-opening-portfolio-link">
        Portfolio
      </a>
    </nav>
  </section>
  <section class="recent-posts" aria-labelledby="recent-posts-heading">
    <h2 id="recent-posts-heading">오늘 발행된 글</h2>
    <ul class="grouped-list">
      {recentPosts.length > 0 ? (
        recentPosts.map((post) => <PostCard post={post} summary={getPreviewSummary(post.slug)} />)
      ) : (
        <li class="grouped-empty">오늘 발행된 글이 없습니다.</li>
      )}
    </ul>
  </section>
</BaseLayout>
